      "tags": ["new_path", "bold"], "risk": "medium",
      "check": { "kind": "terrain", "dc_offset": 2 },
      "outcomes": {
        "success": {
          "effects": [
            { "type": "dungeon_mod", "op": "skip_rooms", "count": 2, "scope": "this_sortie" },
            { "type": "add_xp", "units": 1 },
            { "type": "animation", "action": "sit_eat", "props": ["mine_cart"] }
          ],
          "line": "광차를 타고 단숨에 내려갔다"
        },
        "partial": {
          "effects": [
            { "type": "dungeon_mod", "op": "skip_rooms", "count": 1, "scope": "this_sortie" },
            { "type": "damage", "hp_ratio": 0.1, "when": { "not": { "has_trait": "TI03" } } },
            { "type": "journal", "tag": "trait", "line": "갈림 레일을 먼저 알아봤다", "when": { "has_trait": "TI03" } },
            { "type": "animation", "action": "sit_eat", "props": ["mine_cart"] }
          ],
          "line": "광차가 덜컹이며 멈췄다"
        },
        "failure": {
          "effects": [
            { "type": "damage", "hp_ratio": 0.2 },
            { "type": "injury", "grade": "light", "stat": "dex" }
          ],
          "line": "광차가 레일을 벗어났다"
        }
      }
    },
    {
      "id": "search", "label": "광차 안을 뒤져 본다", "short": "광차 안을 뒤져 보았다",
      "tags": ["reward"], "risk": "low",
      "check": { "kind": "forage", "dc_offset": 0, "partial_allowed": false },
      "outcomes": {
        "success": {
          "effects": [
            { "type": "add_coins", "units": 2 },
            { "type": "add_coins", "units": 1, "when": { "equipped": "W05" } }
