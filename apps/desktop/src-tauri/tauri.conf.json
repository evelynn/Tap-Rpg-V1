{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tap",
  "version": "0.1.0",
  "identifier": "com.tap.rpg",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "텝",
        "width": 800,
        "height": 220,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}