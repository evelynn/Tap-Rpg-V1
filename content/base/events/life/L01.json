{
  "id": "L01",
  "name": "여울가 약초 무더기",
  "category": "life",
  "locations": ["H1", "H2", "A1"],
  "triggers": ["after_encounter", "adventure_event_scene"],
  "seasons": ["spring", "summer", "autumn"],
