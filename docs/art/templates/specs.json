      { "action": "expr_round", "frames": 4, "labels": ["round basic", "round smile", "round worry", "round resolute"] },
      { "action": "expr_narrow", "frames": 4, "labels": ["narrow basic", "narrow smile", "narrow worry", "narrow resolute"] },
      { "action": "collar_neck", "frames": 6, "labels": ["collar_cloth", "collar_leather", "collar_metal", "collar_vampire", "neck_J01", "neck_J02"] }
    ], "note": "초상 부품 25(15 §10) 64×64" },
    { "name": "por_parts_48", "family": "portrait48", "rows": [
      { "action": "hair_front", "frames": 6, "labels": ["HR01", "HR02", "HR03", "HR04", "HR05", "HR06"] },
      { "action": "face_base", "frames": 5, "labels": ["face_round", "face_narrow", "wrinkle_veteran", "wrinkle_elder", "neck_J05"] },
      { "action": "expr_round", "frames": 4, "labels": ["round basic", "round smile", "round worry", "round resolute"] },
      { "action": "expr_narrow", "frames": 4, "labels": ["narrow basic", "narrow smile", "narrow worry", "narrow resolute"] },
      { "action": "collar_neck", "frames": 6, "labels": ["collar_cloth", "collar_leather", "collar_metal", "collar_vampire", "neck_J01", "neck_J02"] }
    ], "note": "초상 부품 25, 48×48" },
    { "name": "ui_icon_16", "family": "icon16", "rows": [
