              "defect": [ { "target": "hit", "op": "add", "value": -1 } ], "exempt_discount_cap": true, "respect_auto_buy": true,
              "when": { "not": { "has_trait": "TI04" } } },
            { "type": "offer_purchase", "pool": { "facilities": ["smithy"], "slots": ["armor"] }, "tier": "character",
              "grade_weights": { "common": 1 }, "price_mult": 0.4,
              "defect": [ { "target": "ac", "op": "add", "value": -1 } ], "exempt_discount_cap": true, "respect_auto_buy": true,
              "when": { "not": { "has_trait": "TI04" } } },
            { "type": "offer_purchase", "pool": { "facilities": ["smithy"], "slots": ["weapon", "armor"] }, "tier": "character",
              "grade_weights": { "common": 1 }, "price_mult": 0.4, "exempt_discount_cap": true, "respect_auto_buy": true,
              "when": { "has_trait": "TI04" } },
            { "type": "journal", "tag": "trait", "line": "직접 숫돌에 날을 세웠다", "detail": "손재주 좋은 {name:은/는} 대장간에 맡기지 않고 직접 숫돌에 날을 세웠다.", "when": { "has_trait": "TI04" } }
          ],
          "line": "휜 {item:을/를} 싸게 샀다"
        }
      }
    },
    {
      "id": "ask_fix", "label": "제대로 고쳐 달라고 한다", "short": "고쳐 달라고 했다",
      "tags": ["reward", "bold"], "risk": "low",
      "check": { "kind": "haggle", "partial_allowed": false },
      "outcomes": {
        "success": {
          "effects": [
            { "type": "offer_purchase", "pool": { "facilities": ["smithy"], "slots": ["weapon", "armor"] }, "tier": "character",
              "grade_weights": { "common": 1 }, "price_mult": 0.6, "exempt_discount_cap": true, "respect_auto_buy": true }
          ],
          "line": "보름이 다시 벼려 주었다"
        },
        "failure": {
