      "check": { "kind": "haggle", "dc": 16 },
      "outcomes": {
        "success": {
          "effects": [
            { "type": "accept_quest", "quest": "L06", "location_var": "target_place", "enemy_var": "enemy",
              "goal_wins": 5, "deadline": "next_sortie", "reward": { "coin_units": 8, "xp_units": 2 },
              "settle": "ratio_floor", "cancel_on": "serious_injury",
              "lines": { "complete": "의뢰를 마쳤다. 동전 {coins}개를 받았다", "partial": "의뢰 절반을 해냈다. 사례를 나눠 받았다", "cancel": "다친 몸으로 의뢰를 내려놓았다" } }
          ],
          "line": "사례를 두둑이 올렸다"
        },
        "partial": {
          "effects": [
            { "type": "accept_quest", "quest": "L06", "location_var": "target_place", "enemy_var": "enemy",
              "goal_wins": 5, "deadline": "next_sortie", "reward": { "coin_units": 7, "xp_units": 2 },
              "settle": "ratio_floor", "cancel_on": "serious_injury",
              "lines": { "complete": "의뢰를 마쳤다. 동전 {coins}개를 받았다", "partial": "의뢰 절반을 해냈다. 사례를 나눠 받았다", "cancel": "다친 몸으로 의뢰를 내려놓았다" } }
          ],
          "line": "사례를 조금 올렸다"
