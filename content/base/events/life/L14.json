          "line": "광차 바닥에서 광석을 긁었다"
        },
        "failure": {
          "effects": [ { "type": "add_fatigue", "value": 3 } ],
          "line": "녹가루만 한 줌 나왔다"
        }
      }
    },
    {
      "id": "walk", "label": "레일을 따라 걸어간다", "short": "레일을 따라 걸어갔다",
      "tags": ["safe"], "risk": "none",
      "outcomes": {
        "always": { "effects": [], "line": "광차를 두고 레일을 따라갔다" }
