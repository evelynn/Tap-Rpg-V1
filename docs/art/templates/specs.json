      { "action": "ground_singles", "frames": 4, "labels": ["notice_board", "bedroll", "infirmary_bed", "lantern_out_belongings"] },
      { "action": "held_singles_a", "frames": 6, "labels": ["mushroom_umbrella", "letter", "potion", "bread", "staff", "bandage_overlay"], "ground": false, "center": false },
      { "action": "held_singles_b", "frames": 3, "labels": ["silver_chalice", "torn_map", "whistle"], "ground": false, "center": false }
    ], "note": "1프레임 소품 13 + zZ 2. 소품 합계 43 = prop_anim_a 18 + prop_anim_b 10 + prop_misc 15" },
    { "name": "npc_ref", "family": "npc", "rows": [
