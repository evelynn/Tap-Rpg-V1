              { "type": "add_xp", "units": 3 },
              { "type": "family_record", "kind": "chronicle", "key": "lord_story", "text": "{generation}대 {name:이/가} 성주의 사연을 들었다." } ] }
        ],
        "line": "잔을 내려놓고 계단을 내려왔다",
        "detail": "\"그 잔은 두고 가지. 언젠가 마음이 바뀔지도 모르니.\""
      } }
    },
    {
      "id": "ask", "label": "성주의 사연을 묻는다", "risk": "none",
      "preview": { "benefit": "성공하면 대가를 줄일 단서를 얻는다", "cost": "없음. 실패해도 변이는 일어나지 않는다. 묻고 난 뒤 위 두 선택지 중 하나를 다시 고른다", "reversible": true },
      "check": { "any_of": ["lore", "persuade"], "dc": 16, "partial_allowed": false },
      "outcomes": {
        "success": {
          "effects": [ { "type": "set_flag", "key": "life.f03_clue" }, { "type": "reopen_choices", "exclude": ["ask"] } ],
