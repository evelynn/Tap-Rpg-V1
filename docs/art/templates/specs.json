      { "action": "injury_special", "frames": 7, "labels": ["injury light1", "injury light2", "injury heavy", "paused", "settling", "curse", "vampire"] },
      { "action": "mark_attitude", "frames": 6, "labels": ["choice mark", "heir mark", "attitude 1", "attitude 2", "attitude 3", "menu"] },
      { "action": "slot_tray", "frames": 6, "labels": ["slot 1", "slot 2", "slot 3", "slot 4", "tray basic", "tray choice dot"] }
    ], "note": "16×16 아이콘 27(15 §11)" },
    { "name": "ui_icon_12", "family": "icon12", "rows": [
