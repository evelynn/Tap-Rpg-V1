        },
        "failure": { "effects": [], "line": "글씨가 번져 읽을 수 없었다" }
      }
    },
    {
      "id": "loot", "label": "쓸 만한 물건을 챙긴다", "short": "쓸 만한 물건을 챙겼다",
      "tags": ["reward"], "risk": "low",
      "check": { "kind": "forage", "dc_offset": 2, "partial_allowed": false },
      "outcomes": {
        "success": {
          "effects": [
            { "type": "chance", "p": 0.15,
