{
  "name": "tap-rpg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/core/tsconfig.test.json && tsc -p packages/content-kit && tsc -p tools/sim && tsc -p tools/demo && tsc -p tools/art-check",
    "test": "node --import tsx --test \"packages/*/test/**/*.test.ts\" \"tools/*/test/**/*.test.ts\"",
    "lint:ids": "tsx packages/content-kit/src/scripts/check-core-ids.ts",
    "lint:docs": "python docs/design/tools/lint_docs.py",
    "content:check": "tsx packages/content-kit/src/cli.ts check content/base",
    "content:schema": "tsx packages/content-kit/src/cli.ts schema content/schemas",
    "check": "pnpm typecheck && pnpm test && pnpm lint:ids && pnpm lint:docs && pnpm content:check",
    "sim": "tsx tools/sim/src/cli.ts",
    "demo": "tsx tools/demo/src/cli.ts",
    "art:check": "tsx tools/art-check/src/cli.ts check",
    "art:normalize": "tsx tools/art-check/src/cli.ts normalize",
    "art:preview": "tsx tools/art-check/src/cli.ts preview"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.9"
    }
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.19.3",
    "typescript": "5.9.2"
  }
}
