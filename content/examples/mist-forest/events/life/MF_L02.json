{
  "id": "MF_L02",
  "name": "반딧불 무리",
  "category": "life",
  "locations": ["MF_H1", "MF_A1"],
  "triggers": ["after_encounter", "adventure_event_scene"],
  "condition": true,
  "weight": 6,
  "weight_mods": [ { "when": { "flag": "life.mf_firefly_marked_{place}" }, "mult": 3 } ],
  "cooldown_min": 25,
  "max_per_life": 4,
  "allow_serious_injury": false,
  "hold": "none",
  "intro": {
    "lines": [ "이끼 위로 반딧불이 떠올랐다", "{name:이/가} 걸음을 멈췄다" ],
    "detail": "불빛이 안개를 옅게 밀어낸다. 무리가 한쪽으로 흐르는 것을 보면 물이 가까운 모양이다.",
    "tag": "discovery",
    "animation": [ { "action": "discover" } ]
  },
  "choices": [
    {
      "id": "follow", "label": "불빛이 흐르는 쪽을 따라간다", "short": "반딧불을 따라갔다",
      "tags": ["new_path"], "risk": "low",
      "check": { "kind": "pathfinding", "dc_offset": 0,
        "situational": [ { "target": "check.all", "op": "add", "value": 2, "when": { "flag": "life.mf_firefly_marked_{place}" } } ] },
      "outcomes": {
        "success": {
          "effects": [
            { "type": "add_xp", "units": 1 },
            { "type": "temp_mod", "modifier": { "target": "discovery_chance_mult", "op": "mul", "value": 1.3 }, "scope": "sortie" },
            { "type": "skill_use", "skill": "search", "count": 1 }
          ],
          "line": "불빛을 따라 샛길을 찾았다"
        },
        "failure": {
          "effects": [ { "type": "add_fatigue", "value": 5 } ],
          "line": "불빛을 놓치고 안개 속에서 돌았다"
        }
      }
    },
    {
      "id": "mark", "label": "반딧불 자리를 외워 둔다", "short": "반딧불 자리를 외워 두었다",
      "tags": ["info"], "risk": "none",
      "outcomes": {
        "always": {
          "effects": [ { "type": "set_flag", "key": "life.mf_firefly_marked_{place}" } ],
          "line": "이끼 바위에 자리를 표시했다"
        }
      }
    },
    {
      "id": "pass", "label": "그냥 지나간다", "short": "반딧불을 지나쳤다",
      "tags": ["safe"], "risk": "none",
      "outcomes": {
        "always": {
          "effects": [ { "type": "add_fatigue", "value": -2 } ],
          "line": "불빛을 등지고 걸었다"
        }
      }
    }
  ]
}
